{
    "apps": [
        {
            "name": "reverb-selling",
            "script": "artisan",
            "args": "reverb:start --port=8081",
            "interpreter": "php",
            "instances": 1,
            "autorestart": true,
            "watch": false,
            "max_memory_restart": "1G",
            "out_file": "/dev/null",
            "error_file": "/dev/null",
            "env": {
                "NODE_ENV": "production"
            }
        },
        {
            "name": "queue-worker-selling",
            "script": "artisan",
            "args": "queue:work --tries=3",
            "interpreter": "php",
            "instances": 1,
            "autorestart": true,
            "watch": false,
            "max_memory_restart": "512M",
            "out_file": "/dev/null",
            "error_file": "/dev/null",
            "env": {
                "NODE_ENV": "production"
            }
        }
    ]
}